{
  "name": "@prompt-optimizer/mcp-server",
  "version": "0.2.0-beta.3",
  "description": "Optimize, test, and compare prompts with models from your Prompt Optimizer desktop or browser workspace via MCP.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "prompt-optimizer-mcp": "./bin/prompt-optimizer-mcp.cjs",
    "prompt-optimizer-product-mcp": "./bin/prompt-optimizer-product-mcp.cjs",
    "prompt-optimizer-desktop-mcp": "./bin/prompt-optimizer-desktop-mcp.cjs"
  },
  "scripts": {
    "build": "tsup src/index.ts src/start.ts src/desktop.ts src/desktop-business.ts src/product.ts src/legacy.ts --format cjs,esm --dts --clean",
    "pack:npm": "node scripts/pack-npm.mjs",
    "dev": "node dist/start.js --mode=legacy --transport=http",
    "start": "node dist/start.cjs --mode=legacy --transport=http",
    "start:desktop-readonly": "node dist/start.cjs --mode=desktop-readonly",
    "start:desktop": "node bin/prompt-optimizer-desktop-mcp.cjs",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:browser-product": "node tests/browser-product.acceptance.mjs",
    "test:desktop-readonly": "vitest run --config vitest.desktop-readonly.config.ts",
    "test:desktop-business": "vitest run --config vitest.desktop-business.config.ts && node --test tests/desktop-business.acceptance.mjs",
    "test:desktop-stdio": "node --test --test-concurrency=1 tests/desktop-stdio.acceptance.mjs tests/desktop-comparison.acceptance.mjs",
    "test": "vitest run",
    "lint": "eslint src --ext .ts",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "prompt-optimization",
    "llm",
    "ai"
  ],
  "author": "Prompt Optimizer Team",
  "license": "AGPL-3.0-only",
  "homepage": "https://github.com/linshenkx/prompt-optimizer#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/linshenkx/prompt-optimizer.git",
    "directory": "packages/mcp-server"
  },
  "bugs": {
    "url": "https://github.com/linshenkx/prompt-optimizer/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@prompt-optimizer/core": "workspace:*",
    "debug": "^4.4.3",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/debug": "^4.1.13",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.4",
    "@types/ws": "^8.18.2",
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@typescript-eslint/parser": "^8.57.2",
    "esbuild": "0.28.1",
    "eslint": "^10.1.0",
    "globals": "^17.4.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=24 <27"
  },
  "files": [
    "bin",
    "dist",
    "preload-env.cjs",
    "README.md"
  ]
}
